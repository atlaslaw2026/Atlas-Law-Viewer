# Secrets - NEVER commit
.env

# Local database
atlas_law.db
atlas_law.backup*.db

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/

# App runtime output
logs/
*.log
